# Public configuration (safe to expose to the browser)
NEXT_PUBLIC_ROOT_DOMAIN=tryggsignal.se
NEXT_PUBLIC_MARKETING_URL=https://tryggsignal.se

# Control plane (server-only). The publishable key is not a secret, but it still
# has no reason to be exposed through NEXT_PUBLIC_*.
CONTROL_PLANE_SUPABASE_URL=
CONTROL_PLANE_SUPABASE_PUBLISHABLE_KEY=

# SecretProvider reference for the privileged control-plane credential.
# This is a reference, never the credential itself (masterplan 173).
CONTROL_PLANE_SECRET_REFERENCE=

# Per-tenant secrets are resolved by reference through the SecretProvider, e.g.
# reference "tenant/mjolby/prod/service" reads TS_SECRET_TENANT_MJOLBY_PROD_SERVICE
# in the EnvSecretProvider implementation used for pilot scale.

# Routing
PREVIEW_HOST_SUFFIX=vercel.app
# Set to true ONLY when the deployment sits behind an additional trusted proxy
# that rewrites x-forwarded-host. On Vercel, leave it unset (masterplan 160).
TRUST_FORWARDED_HOST=false

# Development data plane used by tests/rls/authorization_matrix.sql
DEV_DATA_PLANE_URL=

# Never place a service-role key, API secret or password in this file, in Git,
# in a NEXT_PUBLIC_* variable, in logs, or in a plain database column.
