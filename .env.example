# ---------------------------------------------------------------------------
# Tryggsignal — environment configuration
#
# Copy to .env.local for local work. In production these are set in the Vercel
# project, per environment.
#
# Never place a service-role key, API secret or password in this file, in Git,
# in a NEXT_PUBLIC_* variable, in logs, or in a plain database column
# (masterplan 85).
# ---------------------------------------------------------------------------

# --- Required: routing -----------------------------------------------------
# The apex platform domain. Everything else is derived from it: app.<root>,
# kommuner.<root>, <kommun>.<root>. Defaults to tryggsignal.se if unset.
NEXT_PUBLIC_ROOT_DOMAIN=tryggsignal.se

# --- Required: control plane ------------------------------------------------
# The Supabase project holding platform.tenants, tenant_domains, branding and
# deployments. The publishable key is not a secret, but it still has no reason
# to be exposed through NEXT_PUBLIC_*.
CONTROL_PLANE_SUPABASE_URL=https://<project-ref>.supabase.co
CONTROL_PLANE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Required for server-side tenant runtime -------------------------------
# SecretProvider reference for the control-plane service credential used only by
# service-role-only RPCs. Example reference maps to the environment variable
# TS_SECRET_CONTROL_PLANE_SERVICE_ROLE. Never expose the credential itself.
CONTROL_PLANE_SECRET_REFERENCE=control-plane/service-role
TS_SECRET_CONTROL_PLANE_SERVICE_ROLE=

# --- Required for sign-in ---------------------------------------------------
# Independent HMAC keys for signed login state and privacy-preserving distributed
# rate-limit subjects. Generate separate random values (minimum 32 characters).
#   openssl rand -base64 48
SIGN_IN_STATE_SECRET=
RATE_LIMIT_KEY_SECRET=

# --- Optional: routing ------------------------------------------------------
# Host suffix whose requests resolve to the gateway instead of a tenant, so a
# preview deployment never serves a production municipality by host
# (masterplan 205). Defaults to vercel.app.
PREVIEW_HOST_SUFFIX=vercel.app

# Set to true ONLY when the deployment sits behind an additional trusted proxy
# that rewrites x-forwarded-host. On Vercel the platform sets `host` itself, so
# leave this false (masterplan 160).
TRUST_FORWARDED_HOST=false

# --- Optional: marketing ----------------------------------------------------
NEXT_PUBLIC_MARKETING_URL=https://tryggsignal.se

# --- Optional: per-tenant secrets by reference ------------------------------
# Federated auth and integration credentials are resolved by reference. Example:
# "tenant/mjolby/entra" -> TS_SECRET_TENANT_MJOLBY_ENTRA.

# --- Local tooling only, never set in a deployed environment -----------------
# Connection string used by tests/rls/authorization_matrix.sql and the SQL
# integration tests. This is a direct Postgres URL and therefore a secret.
DEV_DATA_PLANE_URL=

# ---------------------------------------------------------------------------
# Worker (services/worker) — not used by the web apps
# ---------------------------------------------------------------------------

# The data plane this worker consumes queues from. Use a database role that may
# execute the config.* job functions. Never a service-role key, never `anon`,
# and never a NEXT_PUBLIC_* variable — this is a connection string with a
# password in it (masterplan 85).
#   postgresql://<role>:<password>@<host>:5432/postgres
DATABASE_URL=

# Identifier recorded in config.worker_runs. Defaults to the hostname.
WORKER_ID=

# Comma-separated subset of queues, for running a dedicated process for one
# heavy queue. Unknown names fail at startup. Defaults to all ten.
WORKER_QUEUES=

# Messages per read, and how long a job may run before its lease expires and the
# message is redelivered. Defaults: 10 and 60.
WORKER_BATCH_SIZE=
WORKER_VISIBILITY_SECONDS=
